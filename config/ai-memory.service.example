[Unit]
Description=Collect approved AI conversations and sync NotebookLM segments

[Service]
Type=simple
WorkingDirectory=/ABSOLUTE/PATH/Memory
ExecStart=/ABSOLUTE/PATH/Memory/.venv/bin/ai-memory --db /ABSOLUTE/PATH/archive.sqlite watch --codex-path %h/.codex/sessions --opencode-path %h/.local/share/opencode
Restart=on-failure
RestartSec=30
Nice=10
UMask=0077

[Install]
WantedBy=default.target
