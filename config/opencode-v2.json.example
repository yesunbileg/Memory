{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "ai_memory": {
        "type": "local",
        "command": [
          "/ABSOLUTE/PATH/Memory/.venv/bin/ai-memory",
          "--db",
          "/ABSOLUTE/PATH/archive.sqlite",
          "mcp"
        ],
        "timeout": {
          "startup": 30000,
          "execution": 240000
        }
      }
    }
  }
}
